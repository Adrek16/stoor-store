# ── مفتاح توقيع كوكيز المتجر (مطلوب) ────────────────────────
# يوقّع كوكي جلسة العميل (stoor_customer) وكوكي الوصول للطلب (stoor_orders).
# إدارة المتجر تطبيق محلي منفصل («مدير») وله مفتاحه الخاص — لا يوجد
# رمز مشترك (ADMIN_TOKEN) ولا دخول إداري من المتجر.
# ولّده بـ: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=your-long-random-secret

# ── قاعدة البيانات (Supabase) ────────────────────────────────
# عند ضبطهما يقرأ المتجر المنتجات من قاعدة البيانات، وتُحفظ الطلبات فيها.
# بدونهما يعمل المتجر على البيانات المحلية في src/lib/products.ts
# والطلبات في ملف .data/orders.jsonl (تطوير فقط).
#
# ⚠️ استخدم مفتاح service_role لا anon — يُقرأ على الخادم فقط.
SUPABASE_URL=https://xxxxx.supabase.co
# عنوان المشروع فقط، آمن للنشر — يُستخدم لبناء روابط الصور العامة في المتصفح.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# مفتاح anon (قابل للنشر). يُستخدم فقط لتسجيل/دخول العملاء عبر
# Supabase Auth من الخادم — لا يُسرّب للمتصفح ولا يقرأ بيانات محمية
# (RLS تمنع ذلك). يمكن أن يكون ظاهراً في المستودع بأمان.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxteG1xbXJidmNoZHhwenJ1bWN4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM1NjY2NDEsImV4cCI6MjEwOTE0MjY0MX0.f-WAkLUGOT13RPrlLW7QPZi8N0hGrdWpgaPYoXs7sDA

# معرّف المشروع (اختياري — يُستنتج من SUPABASE_URL) ومفتاح إدارة Supabase.
# SUPABASE_ACCESS_TOKEN مطلوب فقط لتنفيذ supabase/schema.sql عبر `npm run db:migrate`.
# كلاهما سرّي — لا يُرفع إلى Git.
# SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx

# ── اتصال Postgres المباشر (اختياري) ────────────────────────
# لا يحتاجه التطبيق وقت التشغيل — يُستخدم فقط لتنفيذ المخطط
# عبر `npm run db:migrate` بدل لصق SQL في لوحة Supabase.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── الدفع ───────────────────────────────────────────────────
# لا توجد بوابة دفع إلكترونية: البطاقة أُزيلت نهائياً.
# طرق الدفع: تحويل بنكي (بيانات الحساب تُدار من لوحة المدير المحلية) أو عند الاستلام.
# لا تحتاج أي متغيرات بيئة للدفع.

# سر مشترك مع لوحة المدير المحلية — يفعّل POST /api/revalidate
# اتركه فارغاً لتعطيل المسار. ولّده بـ: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STORE_REVALIDATE_SECRET=
